{
  "name": "svsu-mern-student-portal",
  "version": "1.0.0",
  "description": "Swami Vivekanand Subharti University - MERN Stack Student ERP Portal (MongoDB, Express, React, Node.js)",
  "main": "index.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "client": "npm --prefix client run dev",
