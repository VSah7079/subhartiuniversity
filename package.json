    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "morgan": "^1.10.0"
  },
  "keywords": [
    "mern",
    "react",
    "express",
    "mongodb",
    "subharti-university",
    "student-login",
    "erp",
    "hostinger"
